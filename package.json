{
  "name": "react-rrule-builder-ts",
  "version": "0.1.3",
  "description": "rrule component for react with mui",
  "main": "dist/rrule-generator.umd.js",
  "module": "dist/rrule-generator.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "preinstall": "npx only-allow yarn",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint . --ext .ts,.tsx",
    "release": "yarn version --patch && git push origin main --tags && V=$(node -p \"require('./package.json').version\") && awk -v v=\"$V\" '$0 ~ \"^## \\\\[\" v \"\\\\]\" {p=1; next} /^## \\[/ {p=0} p' CHANGELOG.md > /tmp/release-notes.md && [ -s /tmp/release-notes.md ] && gh release create v$V --title v$V --notes-file /tmp/release-notes.md --generate-notes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcantatore/react-rrule-builder-ts.git"
  },
  "keywords": [
    "react",
    "rrule",
    "rrule-generator",
    "react-rrule",
    "react-rrule-generator",
    "react-rrule-generator-ts",
    "component",
    "validation"
  ],
  "author": "Dario Cantatore",
  "license": "ISC",
  "peerDependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^6.3.0",
    "@mui/x-date-pickers": "^7.23.3",
    "lodash": "^4.17.21",
    "luxon": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrule": "^2.8.1",
    "yup": "^1.4.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.5",
    "@mui/material": "^6.5.0",
    "@mui/x-date-pickers": "^7.29.4",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/addon-onboarding": "^8.6.18",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.15",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash": "^4.17.5",
    "@types/luxon": "^3.7.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.15.0",
    "jsdom": "^28.1.0",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrule": "^2.8.1",
    "storybook": "^8.6.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^7.18.0",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^4.1.11",
    "yup": "^1.7.1",
    "zustand": "^4.5.7"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
